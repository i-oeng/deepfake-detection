#!/usr/bin/env bash
# Run once on xixi as a member of deepfake-editors. No root privileges needed.
set -euo pipefail
project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
runtime="$project_root/runtime/gpu-queue"
temp_root="$runtime/tmp"
mkdir -p "$temp_root"
chgrp deepfake-editors "$runtime" "$temp_root"
chmod 2770 "$runtime" "$temp_root"
# Preserve group access for ordinary outputs. The submission wrapper repairs
# mkstemp-created task logs separately because mkstemp explicitly uses 0600.
setfacl -m g:deepfake-editors:rwx,m::rwx "$runtime" "$temp_root"
setfacl -d -m g:deepfake-editors:rwx,m::rwx "$runtime" "$temp_root"
"$project_root/scripts/gpu-tsp" -S 1
stat -c '%A %U %G %n' "$runtime" "$temp_root" "$runtime/task-spooler.sock"
