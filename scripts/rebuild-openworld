#!/usr/bin/env bash
# Rebuild the open-world protocol: catalog, materialize, manifest, prune, final manifest.
# Each step writes its JSON result to runtime/ow_<n>_<step>.json.
set -euo pipefail
project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$project_root"
export PYTHONPATH="$project_root/src"
python="${PYTHON:-$HOME/deepfake-detection/.venv/bin/python}"
subset=data/subsets/df40/df40_openworld_v1
mkdir -p runtime

"$python" -m deepfake_detection.data.openworld catalog \
  --downloads-root data/raw/df40/downloads \
  --output "$subset/catalog_selected.csv" --seed 20261007 > runtime/ow_1_catalog.json
"$python" -m deepfake_detection.data.openworld materialize \
  --catalog "$subset/catalog_selected.csv" --downloads-root data/raw/df40/downloads \
  --data-root data/raw/df40_openworld --output "$subset/catalog_materialized.csv" \
  --workers 12 > runtime/ow_2_materialize.json
# The dataset config reads catalog.csv: first the unpruned rows, then the pruned rows.
cp "$subset/catalog_materialized.csv" "$subset/catalog.csv"
"$python" -m deepfake_detection.data.cli build \
  --config configs/datasets/df40_openworld_v1.yaml --allow-audit-failures \
  > runtime/ow_3_manifest_unpruned.json
unpruned="$("$python" -c \
  "import json; print(json.load(open('runtime/ow_3_manifest_unpruned.json'))['manifest'])")"
"$python" -m deepfake_detection.data.openworld prune \
  --catalog "$subset/catalog_materialized.csv" --manifest-dir "$(dirname "$unpruned")" \
  --output "$subset/catalog.csv" > runtime/ow_4_prune.json
"$python" -m deepfake_detection.data.cli build \
  --config configs/datasets/df40_openworld_v1.yaml > runtime/ow_5_manifest.json
echo "open-world protocol rebuilt"
